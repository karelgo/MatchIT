# Copy to .env and fill in. All variables are prefixed MATCHIT_.
MATCHIT_ENVIRONMENT=development
MATCHIT_DATABASE_URL=postgresql+asyncpg://matchit:matchit@localhost:5432/matchit
MATCHIT_REDIS_URL=redis://localhost:6379/0
MATCHIT_QDRANT_URL=http://localhost:6333

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MATCHIT_JWT_SECRET=

MATCHIT_LLM_PROVIDER=anthropic
MATCHIT_ANTHROPIC_API_KEY=
MATCHIT_OPENAI_API_KEY=

# Microsoft Foundry (Azure AI Foundry). Set MATCHIT_LLM_PROVIDER=foundry to use these.
# The endpoint may be the resource root or a full .../openai/v1/responses URL.
MATCHIT_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/responses
MATCHIT_FOUNDRY_API_KEY=
MATCHIT_FOUNDRY_MODEL=gpt-5.4-nano

MATCHIT_EMBEDDING_PROVIDER=openai
MATCHIT_VECTOR_BACKEND=qdrant

MATCHIT_APPLE_CLIENT_ID=com.matchit.app
